{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["bun", "node", "@webgpu/types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@joeee/fcs": ["./packages/fcs/src/index.ts"],
      "@joeee/cytometry-core": ["./packages/cytometry-core/src/index.ts"],
      "@joeee/cytometry-gpu": ["./packages/cytometry-gpu/src/index.ts"],
      "@joeee/engine-controller": ["./packages/engine-controller/src/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "**/pkg",
    "**/target",
    "**/dist",
    "app-web/vite.config.ts"
  ]
}
